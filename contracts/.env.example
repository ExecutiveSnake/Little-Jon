# Robinhood Chain RPC endpoints (used by foundry.toml [rpc_endpoints])
ROBINHOOD_TESTNET_RPC_URL=https://testnet-rpc.robinhood-chain.example
ROBINHOOD_MAINNET_RPC_URL=https://rpc.robinhood-chain.example

# Block explorer verification (used by foundry.toml [etherscan])
ROBINHOOD_EXPLORER_API_URL=https://explorer-testnet.robinhood-chain.example/api
ROBINHOOD_EXPLORER_API_KEY=

# Deployment (script/DeployAnalysisCredits.s.sol)
PRIVATE_KEY=0x
SETTLEMENT_TOKEN=0x0000000000000000000000000000000000000000
COST_PER_CALL=1000000000000000000
MARGIN_BPS=500
RATE_UPDATE_DELAY=86400
ADMIN_ADDRESS=
RELAYER_ADDRESS=

# ============================================================
# Little Jon — trading bot configuration
# Defaults target Robinhood Chain TESTNET (chain ID 46630).
# For mainnet: CHAIN_ID=4663, CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com,
# BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2
# ============================================================

CHAIN_ID=46630
CHAIN_RPC_URL=https://rpc.testnet.chain.robinhood.com
BLOCKSCOUT_API_URL=https://explorer.testnet.chain.robinhood.com/api/v2

# Core token addresses. Defaults are the published MAINNET addresses — override
# with testnet equivalents when running against testnet.
# rhETH (L2 WETH) mainnet: 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73 (testnet: 0x7943e237c7F95DA44E0301572D358911207852Fa)
RHETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# L2 Multicall mainnet: 0x2cAC2D899eCC914d704FeaAE33ac1bF36277DaD1 (testnet: 0xa432504b6F04Cafe775b09D8AA92e8dbe41Ec7a8)
MULTICALL3_ADDRESS=0x2cAC2D899eCC914d704FeaAE33ac1bF36277DaD1
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- NOT YET PUBLISHED for Robinhood Chain: set these when known -------------
# Uniswap V2 deployment (RobinFun tokens graduate into it). Find via any
# graduated pair's factory() on Blockscout, or Robinhood/Uniswap docs.
#UNIV2_FACTORY_ADDRESS=
#UNIV2_ROUTER_ADDRESS=
# 0x RFQ endpoint for stock-token swaps (stock trading disabled until set).
#ZEROX_RFQ_API_URL=
#ZEROX_API_KEY=
# Chainlink L2 sequencer uptime feed + ETH/USD feed for Robinhood Chain
# (canonical list: https://docs.chain.link/data-feeds/price-feeds/addresses?network=robinhood)
#SEQUENCER_UPTIME_FEED=
#ETH_USD_FEED=
# Per-stock-token feeds go in config/chainlink-feeds.json (see example file).
# -----------------------------------------------------------------------------

# Metering service (the AnalysisCredits-gated Claude analysis API)
METERING_SERVICE_URL=http://localhost:8787

# Analysis gating. CONFIDENCE_THRESHOLD has a hard floor of 65 (values below
# are clamped up). Each analysis attempt consumes one prepaid credit.
CONFIDENCE_THRESHOLD=65
MAX_ANALYSIS_ATTEMPTS=3

# --- Execution (ZeroDev Kernel smart account, EntryPoint v0.7) ---------------
# Leave unset to run in DRY RUN mode: everything works but no transaction is
# ever sent. Set both to go live.
# ZeroDev project RPC: https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/4663
#ZERODEV_RPC_URL=
# The bot's signer key. Keep in a secrets manager in production. See
# execution/zerodev.ts for the session-key hardening path before real funds.
#SESSION_KEY_PRIVATE_KEY=
SESSION_KEY_POLICY_PATH=./config/session-key-policy.json
#SMART_ACCOUNT_ADDRESS=

# --- Watcher ------------------------------------------------------------------
WATCHER_POLL_INTERVAL_MS=30000
ENTRY_TRIGGER_TTL_HOURS=168

# --- Risk guardrails ------------------------------------------------------------
MAX_POSITION_SIZE_USD=1000
MAX_SLIPPAGE_BPS=100
DAILY_LOSS_LIMIT_USD=200
KILL_SWITCH_PATH=./config/KILL_SWITCH

# --- Storage / notifications ---------------------------------------------------
DB_PATH=./data/littlejon.db
# Discord-compatible webhook for trade notifications (entries, exits, failures).
#NOTIFY_WEBHOOK_URL=

LOG_LEVEL=info

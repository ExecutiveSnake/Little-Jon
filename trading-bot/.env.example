# Robinhood Chain RPC + bundler (ERC-4337). Replace with real endpoints — see README.
CHAIN_RPC_URL=https://testnet-rpc.robinhood-chain.example
BUNDLER_RPC_URL=https://testnet-bundler.robinhood-chain.example/rpc
CHAIN_ID=0

# ERC-4337 infra
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
SMART_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
SMART_ACCOUNT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Session key: a hot key held by this bot process, scoped by SESSION_KEY_POLICY_PATH
# (see src/smartAccount/sessionKeyPolicy.ts) to specific target contracts/selectors,
# a max value per call, and an expiry. It must NEVER be able to move the account's
# full custody key or change the account's owner/modules.
SESSION_KEY_PRIVATE_KEY=0x
SESSION_KEY_POLICY_PATH=./config/session-key-policy.json

# Chainlink price feeds on Robinhood Chain (Stock Token / USD aggregators)
CHAINLINK_FEED_REGISTRY=0x0000000000000000000000000000000000000000

# Metering service (internal API from ../metering-service)
METERING_SERVICE_URL=http://localhost:8787

# Risk guardrails
MAX_POSITION_SIZE_USD=1000
MAX_SLIPPAGE_BPS=50
DAILY_LOSS_LIMIT_USD=200
KILL_SWITCH_PATH=./config/KILL_SWITCH

LOG_LEVEL=info

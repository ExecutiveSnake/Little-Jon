# Robinhood Chain RPC (Alchemy WebSocket endpoint — replace <network> with the
# Alchemy app slug for Robinhood Chain testnet once available; see README).
ALCHEMY_WSS_URL=wss://robinhood-chain-testnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# HTTP RPC used for reconciliation reads / retries when the WS connection drops.
ALCHEMY_HTTPS_URL=https://robinhood-chain-testnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# AnalysisCredits contract
ANALYSIS_CREDITS_ADDRESS=0x0000000000000000000000000000000000000000

# Relayer key. Must hold RELAYER_ROLE on AnalysisCredits. Keep this in a secrets
# manager / KMS in production — never commit a real key.
RELAYER_PRIVATE_KEY=0x

# Model API used for token/stock-token analysis.
MODEL_API_URL=https://api.your-model-provider.example/v1/analyze
MODEL_API_KEY=

# Local durable idempotency store (SQLite file).
IDEMPOTENCY_DB_PATH=./data/metering.db

# HTTP server
PORT=8787

# How many blocks to re-scan on startup to catch up on any Deposit events missed
# while the service was down.
DEPOSIT_BACKFILL_BLOCKS=5000

LOG_LEVEL=info
